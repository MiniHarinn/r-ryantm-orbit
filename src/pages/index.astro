---
import Layout from "@/layouts/main.astro"
import FleetOverview from "@/components/fleet-overview.astro"
import { PackageExplorer } from "@/components/package-explorer"
import GithubPill from "@/components/github-pill.astro"
import { IconPlanet } from "@tabler/icons-react"
---

<Layout>
  <section class="mx-auto w-full max-w-6xl px-6 py-10">
    <div class="pb-6">
      <p class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-muted-foreground">
        <IconPlanet className="size-4" />
        r-ryantm orbit
      </p>
    </div>
    <div class="grid items-start gap-8 lg:grid-cols-[1fr_1.1fr]">
      <div class="flex max-w-2xl flex-col gap-6">
        <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">
          r-ryantm's package orbit.
        </h1>
        <p class="text-base text-muted-foreground sm:text-xl">
          Track nixpkgs-update runs in one place.
        </p>
        <div class="-mt-1 flex flex-wrap gap-3 text-xs">
          <GithubPill author="NixOS" repo="nixpkgs" />
          <GithubPill author="MiniHarinn" repo="r-ryantm-orbit" />
        </div>
      </div>

      <FleetOverview />
    </div>
  </section>

  <PackageExplorer client:load />
</Layout>
