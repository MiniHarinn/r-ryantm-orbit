---
import {
  IconActivity,
  IconStack2,
  IconCheck,
  IconAlertTriangle,
  IconHandStop,
} from "@tabler/icons-react"

export type FleetStats = {
  total: string
  completed: string
  failed: string
  optedOut: string
  updatedAt: string
}

const {
  total,
  completed,
  failed,
  optedOut,
  updatedAt,
} = Astro.props as Partial<FleetStats>
---

<aside class="rounded-3xl border bg-card p-5 text-card-foreground shadow-sm">
  <div class="flex flex-col gap-1">
    <p class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-muted-foreground">
      <IconActivity className="size-4" />
      Status snapshot
    </p>
    <h2 class="text-2xl font-semibold tracking-tight">Fleet overview</h2>
  </div>
  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconStack2 className="size-3" />
      Total
    </p>
      <p class="mt-2 text-2xl font-semibold">{total}</p>
    </div>
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconCheck className="size-3" />
      Completed
    </p>
      <p class="mt-2 text-2xl font-semibold status-success-text">{completed}</p>
    </div>
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconAlertTriangle className="size-3" />
      Failed
    </p>
      <p class="mt-2 text-2xl font-semibold status-error-text">{failed}</p>
    </div>
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconHandStop className="size-3" />
      Opted out
    </p>
      <p class="mt-2 text-2xl font-semibold status-warning-text">{optedOut}</p>
    </div>
  </div>
  <div class="mt-6 rounded-2xl border bg-background px-4 py-3 text-xs text-muted-foreground">
    Updated At: <span class="text-foreground">{updatedAt}</span>
  </div>
</aside>
