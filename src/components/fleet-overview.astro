---
import {
  IconActivity,
  IconStack2,
  IconCheck,
  IconAlertTriangle,
  IconHandStop,
  IconCopy,
  IconMinus,
  IconAlertCircle,
  IconDots,
} from "@tabler/icons-react"

export type FleetStats = {
  total: string
  success: string
  failed: string
  skipped: string
  duplicate: string
  noChange: string
  invalid: string
  other: string
  updatedAt: string
}

const {
  total,
  success,
  failed,
  skipped,
  duplicate,
  noChange,
  invalid,
  other,
  updatedAt,
} = Astro.props as Partial<FleetStats>
---

<aside class="w-full rounded-3xl border bg-card p-5 text-card-foreground shadow-sm">
  <div class="flex flex-col gap-1">
    <p class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-muted-foreground">
      <IconActivity className="size-4" />
      Status snapshot
    </p>
    <h2 class="text-2xl font-semibold tracking-tight">Fleet overview</h2>
  </div>
  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconStack2 className="size-3" />
      Total
    </p>
      <p class="mt-2 text-2xl font-semibold">{total}</p>
    </div>
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconCheck className="size-3" />
      Success
    </p>
      <p class="mt-2 text-2xl font-semibold status-success-text">{success}</p>
    </div>
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconAlertTriangle className="size-3" />
      Failed
    </p>
      <p class="mt-2 text-2xl font-semibold status-error-text">{failed}</p>
    </div>
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconHandStop className="size-3" />
      Skipped
    </p>
      <p class="mt-2 text-2xl font-semibold status-warning-text">{skipped}</p>
    </div>
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconCopy className="size-3" />
      Duplicate
    </p>
      <p class="mt-2 text-2xl font-semibold status-indigo-text">{duplicate}</p>
    </div>
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconMinus className="size-3" />
      No change
    </p>
      <p class="mt-2 text-2xl font-semibold status-neutral-text">{noChange}</p>
    </div>
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconAlertCircle className="size-3" />
      Invalid
    </p>
      <p class="mt-2 text-2xl font-semibold status-error-text">{invalid}</p>
    </div>
    <div class="rounded-2xl border bg-background p-4">
    <p class="inline-flex items-center gap-1 text-[10px] uppercase tracking-[0.18em] text-muted-foreground whitespace-nowrap">
      <IconDots className="size-3" />
      Other
    </p>
      <p class="mt-2 text-2xl font-semibold status-neutral-text">{other}</p>
    </div>
  </div>
  <div class="mt-6 rounded-2xl border bg-background px-4 py-3 text-xs text-muted-foreground">
    Updated At:
    <span class="text-foreground" data-updated-at={updatedAt} id="fleet-updated-at">
      {updatedAt}
    </span>
    <span class="text-foreground" id="fleet-updated-local"></span>
  </div>
</aside>

<script>
  const updatedAtEl = document.getElementById("fleet-updated-at")
  const localEl = document.getElementById("fleet-updated-local")

  if (updatedAtEl && localEl) {
    const raw = updatedAtEl.getAttribute("data-updated-at")
    if (raw) {
      const parsed = new Date(raw)
      if (!Number.isNaN(parsed.getTime())) {
        const formatter = new Intl.DateTimeFormat(undefined, {
          dateStyle: "medium",
          timeStyle: "short",
        })
        localEl.textContent = ` (Local: ${formatter.format(parsed)})`
      }
    }
  }
</script>
